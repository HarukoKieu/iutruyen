# Public local settings only. Secrets are generated once in the private Docker volume.
NOVEL_LOCAL_API_PORT=4000
# Explicitly selected by the user; credentials and backup URI must match this database.
NOVEL_LOCAL_DATABASE=novel-web
# Reuse the five existing data/key volumes after renaming the Compose group.
# These are external so Compose never creates/replaces/removes them implicitly.
NOVEL_DOCKER_VOLUME_PREFIX=novel-local
NOVEL_DOCKER_VOLUMES_EXTERNAL=true
# Approved crawler profiles only; [] keeps all external sources disabled.
# Pagination requires nextCatalogSelector in each paginated source profile (docs/37).
CRAWLER_SOURCES_JSON='[{"hostname":"truyenfull.live","titleSelector":"a.chapter-title","contentSelector":"#chapter-c","chapterLinkSelector":"#list-chapter .list-chapter a","nextCatalogSelector":"#list-chapter .pagination a:has(.glyphicon-menu-right)","removeSelector":".desc-text a[href=\"https://truyenfull.live\"],#chapter-c a[href=\"https://truyenfull.live\"],[style*=\"display: none\"],[style*=\"display:none\"],[id^=\"ads-chapter\"]","storySelectors":{"title":"h3.title","description":".desc-text","author":".info [itemprop=\"author\"]","genres":".info [itemprop=\"genre\"]","status":".info > div:last-child span"}}]'
