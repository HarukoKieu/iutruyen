# Vite dev: backend targets for the server-side proxy. Browsers use /api/v1
# and their current origin for Socket.IO, including phone/tablet tunnel access.
# Production builds: these must be publicly reachable backend URLs.
VITE_API_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000

# Reserved ad positions only; no third-party ad scripts are loaded.
# placeholder (default) shows the positions; off hides them. Rebuild after changing.
VITE_ADS_MODE=placeholder

# Node SSR runtime (not bundled into browser JS). HTTPS origins required in production.
PUBLIC_SITE_URL=http://localhost:5173
SEO_API_ORIGIN=http://localhost:4000
SEO_INDEXABLE=false
# Optional local Node adapter port; keep PUBLIC_SITE_URL aligned.
SSR_PORT=5173
