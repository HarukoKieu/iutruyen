# Server Configuration
NODE_ENV=development
PORT=4000

# Database & Cache (MongoDB & Redis)
MONGODB_URI=mongodb://localhost:27017/webtruyen
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Required in production. Keep the credential in the host's secret manager.
REDIS_PASSWORD=
# Enable for Redis endpoints that support TLS; certificate/hostname checks stay on.
REDIS_TLS=false
# Server-only secret shared with the SSR runtime (never use a VITE_ prefix).
SSR_SIGNING_SECRET=

# JWT RSA-256 Keys (base64 encoded PEM keys)
JWT_PRIVATE_KEY="your_base64_encoded_rsa_private_key_here"
JWT_PUBLIC_KEY="your_base64_encoded_rsa_public_key_here"

# Client & Cookie
CLIENT_URL=http://localhost:5173
COOKIE_DOMAIN=localhost

# OAuth (Google - optional in Phase 0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP Email (optional in Phase 0)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Crawler: approved source profiles; see docs/19-CRAWLER-PROPOSAL.md.
# Empty array disables external sources. Requires Redis and Node >= 22.19.
CRAWLER_SOURCES_JSON='[]'

# Stage A: independent refresh RSA key pair (mandatory in production).
# In development omit BOTH to retain compatibility with the access pair.
# JWT_REFRESH_PRIVATE_KEY=base64_refresh_private_pem
# JWT_REFRESH_PUBLIC_KEY=base64_refresh_public_pem
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
# Comma-separated trusted proxy IPs/subnets; configure from your actual ingress.
TRUST_PROXY=

# Phase 8 — SEO
# URL gốc của frontend (HTTPS ở production, không có trailing slash)
PUBLIC_SITE_URL=http://localhost:5173
# Set true chỉ khi domain production đã cấu hình đúng và muốn index
SEO_INDEXABLE=false
# Interval cập nhật sitemap manifest (ms); min 60000, max 3600000; default 900000 (15 phút)
SEO_SITEMAP_INTERVAL_MS=900000

# Phase 9 local backup: leave empty to disable. Absolute private paths OUTSIDE repository/web roots.
# Key file: base64 32-byte AES key. Mongo config file: JSON {"uri":"same value as MONGODB_URI"}.
# Never put keys/credentials here; service-account-only ACL on Windows, 0700/0600 on Unix.
BACKUP_LOCAL_DIR=
BACKUP_KEY_FILE=
BACKUP_MONGO_CONFIG_FILE=
BACKUP_TIMEOUT_MS=600000
BACKUP_MAX_BYTES=536870912
BACKUP_TOTAL_BYTES=5368709120
