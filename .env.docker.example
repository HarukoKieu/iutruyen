# ========================================================
# Novel Web - Docker Compose Environment Configuration
# ========================================================

# Environment Mode: production | development | test
NODE_ENV=production

# Logging Level: debug | info | warn | error
LOG_LEVEL=info

# Exposed Host Ports
CLIENT_PORT=80
SERVER_PORT=4000
REDIS_PORT_HOST=127.0.0.1:6379
MONGO_PORT_HOST=127.0.0.1:27017

# ========================================================
# Redis Configuration (Authentication required in production)
# ========================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ChangeMe_StrongRedisPassword_2026!
REDIS_TLS=false

# ========================================================
# MongoDB Configuration
# ========================================================
# If using the internal Docker Mongo service:
MONGO_INITDB_ROOT_USERNAME=novel_root
MONGO_INITDB_ROOT_PASSWORD=ChangeMe_StrongMongoPassword_2026!
MONGO_INITDB_DATABASE=webtruyen

# Connection string (Leave blank to use default compose mongo above, or fill if connecting to MongoDB Atlas)
# MONGODB_URI=mongodb://novel_root:ChangeMe_StrongMongoPassword_2026!@mongo:27017/webtruyen?authSource=admin&replicaSet=rs0

# ========================================================
# JWT RS256 RSA Keys (Base64-encoded PEM string)
# ========================================================
# In production, access and refresh key pairs must be separate.
JWT_PRIVATE_KEY="LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tCg..."
JWT_PUBLIC_KEY="LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0K..."
JWT_REFRESH_PRIVATE_KEY="LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tCg..."
JWT_REFRESH_PUBLIC_KEY="LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0K..."

# ========================================================
# Client & Domain Configuration
# ========================================================
CLIENT_URL=http://localhost
COOKIE_DOMAIN=localhost
PUBLIC_SITE_URL=http://localhost
SEO_INDEXABLE=false
SSR_SIGNING_SECRET=your_32_chars_minimum_signing_secret_here

# ========================================================
# OAuth & Email (Optional)
# ========================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
TRUST_PROXY=

# ========================================================
# Crawler Sources Configuration
# ========================================================
CRAWLER_SOURCES_JSON='[]'
