# ==========================================
# 1. Environment Variables & Secrets (Cực kỳ quan trọng)
# ==========================================
**/.env
**/.env.*
**/.env.keys.local
!**/.env.example
!**/.env.*.example
!**/.env.docker.example
!**/.env.production.example
!**/docker-local.env.example

# ==========================================
# 2. Database Backups, Local Keys & Configs
# ==========================================
**/.local-backups/
**/*.nwbackup
**/*.nwbackup.partial
**/backup-key*
**/backup-mongo-config*
**/mongo-*-config.json
!**/mongo-*-config.example.json

# ==========================================
# 3. Dependencies & Package Managers
# ==========================================
**/node_modules/
**/.npmrc
package-lock.json.backup
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# 4. Build Outputs, Caches & Temporary Storage
# ==========================================
**/dist/
**/build/
**/.server/
output/
**/.tmp-crawler-storage/
**/.cache/

# ==========================================
# 5. Logs, Coverage & Audit/Benchmark Reports
# ==========================================
**/coverage/
**/*.log
**/audit-*.json
**/phase-*.json
**/phase-*-benchmark.json
**/phase-*-audit-*.json
**/phase-*-fix-*.json

# ==========================================
# 6. Large Raw Preview Images & Misplaced Folders
# ==========================================
/ChatGPT Image*.png
/iutruyen-concept-01-preview.png
client/@/

# ==========================================
# 7. IDE & Operating System Files
# ==========================================
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
CLAUDE.md
docs
